{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "passes.json: the edit's passes, in order. run.py and the studio both read this file.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "key",
      "label",
      "proves",
      "commands"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 0
      },
      "key": {
        "type": "string",
        "pattern": "^[a-z]+$"
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "proves": {
        "type": "object",
        "required": [
          "descript",
          "local"
        ],
        "additionalProperties": false,
        "properties": {
          "descript": {
            "type": "string",
            "minLength": 1
          },
          "local": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "commands": {
        "type": "object",
        "required": [
          "descript",
          "local"
        ],
        "additionalProperties": false,
        "properties": {
          "descript": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "local": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
