{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pins.json: the shots to place. sequence.py plan writes it, an agent fills FILL ME and picks, pins.py and the studio read it.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["from"],
    "anyOf": [{ "required": ["media"] }, { "required": ["zoom"] }],
    "additionalProperties": false,
    "properties": {
      "_": { "type": "string" },
      "media": { "type": "string", "minLength": 1 },
      "zoom": { "type": "number", "minimum": 1 },
      "from": { "type": "string", "pattern": "\\S" },
      "to": { "type": "string", "pattern": "\\S" },
      "pre": { "type": "string" },
      "post": { "type": "string" },
      "nth": { "type": "integer", "minimum": 1 },
      "in": { "type": "number", "minimum": 0 },
      "dur": { "type": "number", "minimum": 0 },
      "speed": { "type": "number", "minimum": 0 },
      "layout": { "type": ["string", "null"] },
      "why": { "type": "string" },
      "z": { "type": "integer", "minimum": 0 },
      "cam": { "type": "boolean" },
      "geo": { "type": "object" }
    }
  }
}
