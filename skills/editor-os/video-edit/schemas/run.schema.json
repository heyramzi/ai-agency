{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUN.json: the run ledger. run.py writes it; the studio reads it and sets only `route`.",
  "type": "object",
  "required": ["code", "passes"],
  "additionalProperties": false,
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "route": { "enum": ["descript", "local"] },
    "project": { "type": "string" },
    "comp": { "type": "string" },
    "cut": { "type": "string" },
    "take": { "type": "string" },
    "format": { "enum": ["wide", "vertical"] },
    "task": { "type": "string" },
    "checklist": { "type": "string" },
    "recorded": {
      "type": "string",
      "description": "The day it was filmed, YYYY-MM-DD. The shelf's Recorded sort uses it, and breaks ties in the default Updated sort."
    },
    "stitched": {
      "type": "array",
      "description": "Set when `editor-os new --take` joined several takes into one file: the parts in the order they were joined. The originals stay where they were.",
      "items": {
        "type": "object",
        "required": ["file", "seconds"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "seconds": { "type": "number" },
          "createdAt": { "type": "string" }
        }
      }
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state"],
        "additionalProperties": false,
        "properties": {
          "state": { "enum": ["", "started", "done", "blocked"] },
          "evidence": { "type": "string" },
          "override": { "type": "boolean" },
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "proof": {
            "type": "object",
            "required": ["file", "sha256"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "run": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
