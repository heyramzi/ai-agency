{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUN.json: the run ledger. run.py writes it; the studio reads it and sets only `route`.",
  "type": "object",
  "required": ["code", "passes"],
  "additionalProperties": false,
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "route": { "enum": ["descript", "local"] },
    "project": { "type": "string" },
    "comp": { "type": "string" },
    "cut": { "type": "string" },
    "task": { "type": "string" },
    "checklist": { "type": "string" },
    "recorded": {
      "type": "string",
      "description": "The day it was filmed, YYYY-MM-DD. The shelf sorts on it."
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state"],
        "additionalProperties": false,
        "properties": {
          "state": { "enum": ["", "started", "done", "blocked"] },
          "evidence": { "type": "string" },
          "override": { "type": "boolean" },
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "proof": {
            "type": "object",
            "required": ["file", "sha256"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "run": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
