{
  "name": "skill-cleaner",
  "version": "0.2.0",
  "description": "Audit, consolidate and clean up Agent Skills across every place they hide",
  "keywords": [
    "claude",
    "claude-code",
    "agent-skills",
    "skills",
    "lint",
    "audit"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=scripts/skill-cleaner.cjs",
    "build": "tsc -p tsconfig.json && pnpm bundle",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyramzi/vibe-systems.git"
  },
  "private": true
}
