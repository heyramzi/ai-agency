{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "needles.json: the cut list as words. An agent writes it; candidates.py, restate.py and prove_cuts.py read it.",
  "type": "array",
  "items": {
    "anyOf": [
      { "type": "string", "minLength": 1 },
      {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          { "type": "integer", "minimum": 0 },
          { "type": "string", "minLength": 1 }
        ]
      },
      {
        "type": "object",
        "required": ["t"],
        "additionalProperties": false,
        "properties": {
          "b": { "type": "integer", "minimum": 0 },
          "t": { "type": "string", "minLength": 1 }
        }
      },
      {
        "type": "object",
        "required": ["from"],
        "additionalProperties": false,
        "properties": { "from": { "type": "string", "minLength": 1 }, "in": { "type": "string" } }
      }
    ]
  }
}
