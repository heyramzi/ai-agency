{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "passes.json: the edit's passes, in order. run.py and the studio both read this file.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "key", "label", "proves", "commands"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "integer", "minimum": 0 },
      "key": { "type": "string", "pattern": "^[a-z]+$" },
      "label": { "type": "string", "minLength": 1 },
      "proves": { "type": "string", "minLength": 1 },
      "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    }
  }
}
