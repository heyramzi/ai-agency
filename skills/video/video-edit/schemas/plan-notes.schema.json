{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan.notes.json: the notes left on slots. The studio writes them; `studio notes --done` answers one.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "slot", "anchor", "text", "status", "createdAt"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^f[0-9]+$" },
      "slot": { "type": "string", "minLength": 1 },
      "anchor": { "type": "string" },
      "text": { "type": "string" },
      "status": { "enum": ["open", "held", "answered", "done"] },
      "reply": { "type": "string" },
      "thread": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["by", "text"],
          "additionalProperties": false,
          "properties": { "by": { "type": "string" }, "text": { "type": "string" } }
        }
      },
      "working": {
        "type": "object",
        "required": ["text", "at"],
        "additionalProperties": false,
        "properties": { "text": { "type": "string" }, "at": { "type": "string" } }
      },
      "createdAt": { "type": "string" }
    }
  }
}
